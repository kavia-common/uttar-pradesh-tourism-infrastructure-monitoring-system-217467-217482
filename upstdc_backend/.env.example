# Backend environment example for local/dev usage

# Database (defaults match local running Postgres on port 5001)
POSTGRES_URL=jdbc:postgresql://localhost:5001/upstdc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=upstdc
POSTGRES_PORT=5001

# JWT (use a secure 32+ char secret)
JWT_SECRET=please-change-dev-secret-at-least-32-chars-1234567890
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# File storage
FILE_STORAGE_BASE_PATH=./storage
