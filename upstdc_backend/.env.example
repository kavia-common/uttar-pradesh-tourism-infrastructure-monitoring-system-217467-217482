# Database (provided by platform in CI/hosting)
POSTGRES_URL=jdbc:postgresql://localhost:5001/upstdc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=upstdc
POSTGRES_PORT=5001

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# File storage
FILE_STORAGE_BASE_PATH=./storage

# JWT (generate secure values for prod)
JWT_SECRET=change-me-very-long-random
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

# Server
SERVER_PORT=8080
